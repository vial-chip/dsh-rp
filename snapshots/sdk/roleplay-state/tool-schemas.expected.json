      "name": "roleplay_body_read",
      "description": "读取已记录的身体状态，包括身体状况、临时情绪。可选择字段；省略字段时读取本类全部状态。未记录的字段不返回。",
      "parameters": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "array",
            "description": "要读取的字段名称；省略时读取本类全部字段。",
            "items": {
              "type": "string",
              "description": "字段名称，可使用中文。"
            }
          }
        }
      }
    },
    {
      "name": "roleplay_body_update",
